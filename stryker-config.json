{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/src/Stryker.CLI/stryker-schema.json",
  "stryker-config": {
    "solution": "Dp9ik.sln",
    "project": "tests/Dp9ik.Tests/Dp9ik.Tests.csproj",
    "mutate": [
      "src/Dp9ik/**/*.cs",
      "src/Dp9ik.P9Auth/**/*.cs"
    ],
    "reporters": [
      "progress",
      "html"
    ],
    "thresholds": {
      "high": 80,
      "low": 70,
      "break": 60
    }
  }
}
